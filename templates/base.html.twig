                                    <a href="{{ path('app_profil') }}#infos"><i class="bi bi-person"></i>Mon profil</a>
                                    <a href="{{ path('app_profil') }}#commandes"><i class="bi bi-box-seam"></i>Mes commandes</a>
                                    <a href="{{ path('app_rendez_vous') }}"><i class="bi bi-calendar-check"></i>Prendre RDV</a>
