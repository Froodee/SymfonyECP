        <link href="{{ asset(path='vendor/swiper/swiper-bundle.min.css')}}" rel="stylesheet">
        <!-- Main CSS File -->
        <link href="{{ asset(path='css/main.css') }}" rel="stylesheet">
        <style>
            /* ── Toasts ── */
            .toast-container {
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 99999;
                display: flex;
                flex-direction: column;
                gap: 10px;
                max-width: 340px;
            }
            .app-toast {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 13px 16px;
                border-radius: 10px;
                box-shadow: 0 6px 24px rgba(0,0,0,.15);
                font-size: .9rem;
                font-weight: 500;
                color: #fff;
                animation: toastIn .3s cubic-bezier(.22,1,.36,1);
            }
            @keyframes toastIn {
                from { opacity: 0; transform: translateY(16px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .app-toast--success { background: #16a34a; }
            .app-toast--error   { background: #dc3545; }
            .app-toast--warning { background: #d97706; }
            .app-toast--info    { background: #0284c7; }
            .app-toast__icon    { font-size: 1.1rem; flex-shrink: 0; }
            .app-toast__msg     { flex: 1; }
            .app-toast__close   { background: none; border: none; color: rgba(255,255,255,.8); font-size: 1.2rem; cursor: pointer; padding: 0; line-height: 1; margin-left: 4px; }
            .app-toast__close:hover { color: #fff; }

            /* Dropdowns */
            .navmenu li.dropdown > ul {
                display: none;
                position: absolute;
                top: calc(100% + 6px);
                left: 0;
                background: #fff;
                min-width: 210px;
                box-shadow: 0 8px 24px rgba(0,0,0,.13);
                border-radius: 10px;
                padding: 6px 0;
                z-index: 9999;
                list-style: none;
                margin: 0;
            }
            .navmenu li.dropdown { position: relative; }
            .navmenu li.dropdown > ul.open { display: block; }
            .navmenu li.dropdown > ul li a {
                display: flex;
                align-items: center;
                padding: 9px 18px;
                font-size: .88rem;
                color: #333;
                white-space: nowrap;
                text-decoration: none;
            }
            .navmenu li.dropdown > ul li a:hover { color: #dc3545; background: #fff5f5; }

            /* ── Zone compte ── */
            .nav-account-zone {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: 16px;
                padding-left: 16px;
                border-left: 1px solid #e5e5e5;
                flex-shrink: 0;
            }

            /* Bouton utilisateur */
            .nav-user-btn {
                display: flex;
                align-items: center;
                gap: 7px;
                background: #f8f8f8;
                border: 1px solid #e8e8e8;
                border-radius: 24px;
                padding: 5px 12px 5px 5px;
                cursor: pointer;
                font-size: .88rem;
                font-weight: 500;
                color: #333;
                transition: background .2s, border-color .2s;
            }
            .nav-user-btn:hover { background: #f0f0f0; border-color: #ccc; }

            /* Avatar */
            .nav-account-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: #dc3545;
                color: #fff;
                font-size: .75rem;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            /* Dropdown panel */
            .nav-user-dropdown { position: relative; }
            .nav-user-panel {
                display: none;
                position: absolute;
                top: calc(100% + 4px);
                right: 0;
                background: #fff;
                min-width: 230px;
                border-radius: 12px;
                box-shadow: 0 10px 32px rgba(0,0,0,.14);
                overflow: hidden;
                z-index: 9999;
            }
            .nav-user-panel.open { display: block; }

            .nav-user-panel-header {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 16px;
                background: #fafafa;
                border-bottom: 1px solid #f0f0f0;
            }
            .nav-user-panel-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #dc3545;
                color: #fff;
                font-size: .9rem;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }
            .nav-user-panel-header strong { display: block; font-size: .9rem; color: #222; }
            .nav-user-panel-header small  { font-size: .75rem; color: #888; }

            .nav-user-panel a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 16px;
                font-size: .88rem;
                color: #333;
                text-decoration: none;
                transition: background .15s;
            }
            .nav-user-panel a:hover { background: #f5f5f5; color: #dc3545; }
            .nav-user-panel a.logout { color: #dc3545; }
            .nav-user-panel a.logout:hover { background: #fff0f0; }
            .nav-user-panel-divider { height: 1px; background: #f0f0f0; margin: 4px 0; }

            /* Connexion / Inscription */
            .nav-account-login {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: .88rem;
                color: #333;
                text-decoration: none;
                padding: 6px 10px;
                border-radius: 6px;
                transition: color .2s;
            }
            .nav-account-login:hover { color: #dc3545; }
            .nav-account-register {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: .85rem;
                background: #dc3545;
                color: #fff !important;
                text-decoration: none;
                padding: 6px 14px;
                border-radius: 20px;
                transition: background .2s;
            }
            .nav-account-register:hover { background: #b91c1c; }

            /* Panier */
            .nav-cart-btn {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #f0faf4;
                color: #2e7d32;
                font-size: 1.2rem;
                text-decoration: none;
                transition: background .2s;
            }
            .nav-cart-btn:hover { background: #d4edda; }
            .nav-cart-badge {
                position: absolute;
                top: 0;
                right: 0;
                background: #dc3545;
                color: #fff;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                font-size: .6rem;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }
        </style>
    </head>
