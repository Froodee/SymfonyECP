{% extends 'base.html.twig' %}

{% block title %}Mon Profil - ECP : Emballé c'est pesé{% endblock %}

{% block main %}
<section id="profil" class="profil section light-background">

    <div class="container section-title" data-aos="fade-up">
        <h2>Mon Profil</h2>
        <p>Gérez vos informations personnelles et consultez votre historique<br>
        <span class="small text-muted">Espace personnel sécurisé</span></p>
    </div>

    <div class="container">
        <div class="row gy-4">

            <!-- Sidebar Profil -->
            <div class="col-lg-4" data-aos="fade-right">
                <div class="profile-card">
                    <div class="profile-header">
                        <div class="profile-avatar">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <h3>{{ utilisateur ? utilisateur.nomUser : user.email }}</h3>
                        <p class="text-muted">
                            <i class="bi bi-envelope me-2"></i>{{ user.email }}
                        </p>
                        {% if user.isVerified %}
                            <span class="badge bg-success">
                                <i class="bi bi-patch-check-fill me-1"></i>Compte vérifié
                            </span>
                        {% else %}
                            <span class="badge bg-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i>En attente de vérification
                            </span>
                        {% endif %}
                    </div>

                    <div class="profile-stats">
                        <div class="stat-item">
                            <i class="bi bi-cart-check text-success"></i>
                            <div>
                                <h4>{{ commandes|length }}</h4>
                                <p>Commandes</p>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i class="bi bi-star-fill text-warning"></i>
                            <div>
                                <h4>{{ avis|length }}</h4>
                                <p>Avis postés</p>
                            </div>
                        </div>
                    </div>

                    <div class="profile-actions">
                        <a href="#" class="btn btn-outline-success w-100 mb-2">
                            <i class="bi bi-pencil-square me-2"></i>Modifier mon profil
                        </a>
                        <a href="#" class="btn btn-outline-danger w-100">
                            <i class="bi bi-key me-2"></i>Changer mon mot de passe
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contenu principal -->
            <div class="col-lg-8" data-aos="fade-left">

                <!-- Informations personnelles -->
                <div class="content-box mb-4">
                    <h3>
                        <i class="bi bi-person-badge me-2 text-success"></i>
                        Informations personnelles
                    </h3>

                    {% if utilisateur %}
                        <div class="info-grid">
                            <div class="info-item">
                                <label><i class="bi bi-person me-2"></i>Nom complet</label>
                                <p>{{ utilisateur.nomUser }}</p>
                            </div>
                            <div class="info-item">
                                <label><i class="bi bi-envelope me-2"></i>Email</label>
                                <p>{{ utilisateur.emailUser }}</p>
                            </div>
                            <div class="info-item">
                                <label><i class="bi bi-telephone me-2"></i>Téléphone</label>
                                <p>{{ utilisateur.numUser }}</p>
                            </div>
                            <div class="info-item">
                                <label><i class="bi bi-geo-alt me-2"></i>Adresse</label>
                                <p>
                                    {{ utilisateur.adrUser }}<br>
                                    {{ utilisateur.cpUser }} {{ utilisateur.villeUser }}
                                </p>
                            </div>
                            {% if client and client.siret %}
                                <div class="info-item">
                                    <label><i class="bi bi-building me-2"></i>SIRET (Client professionnel)</label>
                                    <p>{{ client.siret }}</p>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Veuillez compléter vos informations personnelles pour profiter pleinement de votre compte.
                        </div>
                        <a href="#" class="btn btn-success">
                            <i class="bi bi-plus-circle me-2"></i>Compléter mon profil
                        </a>
                    {% endif %}
                </div>

                <!-- Historique des commandes -->
                <div class="content-box mb-4">
                    <h3>
                        <i class="bi bi-box-seam me-2 text-success"></i>
                        Mes commandes
                    </h3>

                    {% if commandes|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>N° Commande</th>
                                        <th>Date</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for commande in commandes %}
                                        <tr>
                                            <td><strong>#{{ commande.numCde }}</strong></td>
                                            <td>{{ commande.dateCde|date('d/m/Y') }}</td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Livrée
                                                </span>
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-eye"></i> Détails
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-cart4 text-muted" style="font-size: 4rem;"></i>
                            <h5 class="mt-3 text-muted">Aucune commande pour le moment</h5>
                            <p class="text-muted">Découvrez nos produits de bio-nettoyage écologique !</p>
                            <a href="{{ path('app_boutique') }}" class="btn btn-success mt-2">
                                <i class="bi bi-shop me-2"></i>Voir la boutique
                            </a>
                        </div>
                    {% endif %}
                </div>

                <!-- Mes avis -->
                {% if avis|length > 0 %}
                    <div class="content-box mb-4">
                        <h3>
                            <i class="bi bi-star me-2 text-warning"></i>
                            Mes avis
                        </h3>

                        <div class="avis-list">
                            {% for avi in avis %}
                                <div class="avis-item">
                                    <div class="avis-header">
                                        <div class="avis-stars">
                                            {% for i in 1..5 %}
                                                <i class="bi bi-star-fill text-warning"></i>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <p>{{ avi.commentaire }}</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- Sécurité et confidentialité -->
                <div class="content-box">
                    <h3>
                        <i class="bi bi-shield-lock me-2 text-danger"></i>
                        Sécurité et confidentialité
                    </h3>

                    <div class="security-info">
                        <div class="security-item">
                            <i class="bi bi-lock-fill text-success"></i>
                            <div>
                                <h5>Mot de passe</h5>
                                <p class="text-muted">Dernière modification : Jamais</p>
                                <a href="#" class="text-success">Modifier mon mot de passe</a>
                            </div>
                        </div>

                        <div class="security-item">
                            <i class="bi bi-shield-check text-success"></i>
                            <div>
                                <h5>Vérification du compte</h5>
                                <p class="text-muted">
                                    {% if user.isVerified %}
                                        Votre compte est vérifié
                                    {% else %}
                                        Veuillez vérifier votre adresse email
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <div class="security-item">
                            <i class="bi bi-file-text text-success"></i>
                            <div>
                                <h5>Données personnelles</h5>
                                <p class="text-muted">Gérées conformément au RGPD</p>
                                <a href="{{ path('app_politique') }}" class="text-success">Voir la politique de confidentialité</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Zone d'aide -->
        <div class="row mt-5">
            <div class="col-12" data-aos="fade-up">
                <div class="help-box">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h3>Besoin d'aide avec votre compte ?</h3>
                            <p class="mb-0">
                                Notre équipe est à votre disposition pour répondre à toutes vos questions
                                concernant votre compte ou vos commandes.
                            </p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="{{ path('app_contact') }}" class="btn btn-light btn-lg">
                                <i class="bi bi-headset me-2"></i>Nous contacter
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
