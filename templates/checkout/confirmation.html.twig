{% extends 'base.html.twig' %}

{% block title %}Commande confirmée – ECP{% endblock %}

{% block main %}
<section class="section">
    <div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">
        <div class="text-center p-5 border rounded-4 shadow bg-white" style="max-width:520px;width:100%;" data-aos="zoom-in">

            <div class="mb-4" style="font-size:4rem;animation:pop .6s cubic-bezier(.34,1.56,.64,1) both;">
                🎉
            </div>
            <h2 class="fw-bold mb-2">Commande confirmée !</h2>
            <p class="text-muted mb-4">
                Merci pour votre achat.<br>
                Votre colis partira sous 48h en toute discrétion.
            </p>

            <div class="bg-light border rounded-3 p-3 text-start mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Numéro de commande</span>
                    <strong>#{{ commande.numCde }}</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Date</span>
                    <strong>{{ commande.dateCde|date('d/m/Y') }}</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Montant total</span>
                    <strong class="text-danger">{{ facture.montant|number_format(2, ',', ' ') }} €</strong>
                </div>
            </div>

            <a href="{{ path('app_facture_pdf', {id: facture.id}) }}" class="btn btn-danger rounded-pill px-4 me-2">
                <i class="bi bi-file-earmark-pdf me-1"></i>Télécharger la facture
            </a>
            <a href="{{ path('app_boutique') }}" class="btn btn-outline-danger rounded-pill px-4">
                <i class="bi bi-shop me-1"></i>Continuer
            </a>
        </div>
    </div>
</section>
<style>
@keyframes pop { from{opacity:0;transform:scale(.5)} to{opacity:1;transform:scale(1)} }
</style>
{% endblock %}
