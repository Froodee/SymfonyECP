                </div>
            </div>
        </header>

        {# ── Toasts globaux ── #}
        {% set allFlashes = app.flashes(['success', 'error', 'warning', 'info']) %}
        {% if allFlashes|length > 0 %}
        <div class="toast-container" id="toast-container">
            {% for type, messages in allFlashes %}
                {% for message in messages %}
                <div class="app-toast app-toast--{{ type }}" role="alert">
                    <span class="app-toast__icon">
                        {% if type == 'success' %}<i class="bi bi-check-circle-fill"></i>
                        {% elseif type == 'error' %}<i class="bi bi-x-circle-fill"></i>
                        {% elseif type == 'warning' %}<i class="bi bi-exclamation-triangle-fill"></i>
                        {% else %}<i class="bi bi-info-circle-fill"></i>{% endif %}
                    </span>
                    <span class="app-toast__msg">{{ message }}</span>
                    <button class="app-toast__close" onclick="this.parentElement.remove()">×</button>
                </div>
                {% endfor %}
            {% endfor %}
        </div>
        {% endif %}

        <main>{% block main %}{% endblock %}</main>

