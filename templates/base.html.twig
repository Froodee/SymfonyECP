        <!-- Scroll Top -->
        <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
            <i class="bi bi-arrow-up-short"></i>
        </a>

        <!-- Vendor JS Files -->
        <script src="{{ asset(path='vendor/bootstrap/js/bootstrap.bundle.min.js')}}"></script>
        <script src="{{ asset(path='vendor/php-email-form/validate.js')}}"></script>
        <script src="{{ asset(path='vendor/aos/aos.js')}}"></script>
        <script src="{{ asset(path='vendor/glightbox/js/glightbox.min.js')}}"></script>
        <script src="{{ asset(path='vendor/purecounter/purecounter_vanilla.js')}}"></script>
        <script src="{{ asset(path='vendor/swiper/swiper-bundle.min.js')}}"></script>
        <script src="{{ asset(path='js/main.js')}}"></script>
    </body>
</html>