{% extends 'base.html.twig' %}

{% block title %}Inscription - ECP : Emballé c'est pesé{% endblock %}

{% block main %}
<section id="register" class="login section light-background">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="login-box" data-aos="fade-up">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus-fill" style="font-size: 4rem; color: var(--accent-color);"></i>
                        <h2 class="mt-3">Inscription</h2>
                        <p class="text-muted">Créez votre compte ECP</p>
                    </div>

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            {{ flash_error }}
                        </div>
                    {% endfor %}

                    {{ form_start(registrationForm, {
                        'attr': {'class': 'login-form'}
                    }) }}

                        <div class="form-group mb-4">
                            {{ form_label(registrationForm.email, 'Email', {
                                'label_attr': {'class': 'form-label'}
                            }) }}
                            {{ form_widget(registrationForm.email, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'votre@email.com'
                                }
                            }) }}
                            {{ form_errors(registrationForm.email) }}
                        </div>

                        <div class="form-group mb-4">
                            {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                                'label_attr': {'class': 'form-label'}
                            }) }}
                            {{ form_widget(registrationForm.plainPassword, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': '••••••••'
                                }
                            }) }}
                            {{ form_errors(registrationForm.plainPassword) }}
                            <small class="form-text text-muted d-block mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Minimum 6 caractères
                            </small>
                        </div>

                        <div class="form-check mb-4">
                            {{ form_widget(registrationForm.agreeTerms, {
                                'attr': {'class': 'form-check-input'}
                            }) }}
                            {{ form_label(registrationForm.agreeTerms, null, {
                                'label_attr': {'class': 'form-check-label'}
                            }) }}
                            {{ form_errors(registrationForm.agreeTerms) }}
                        </div>

                        <button type="submit" class="btn btn-login w-100 mb-3">
                            <i class="bi bi-person-check-fill me-2"></i>Créer mon compte
                        </button>

                    {{ form_end(registrationForm) }}

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="text-muted mb-3">Vous avez déjà un compte ?</p>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-success w-100">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message discret -->
        <div class="row justify-content-center mt-5">
            <div class="col-lg-8">
                <div class="text-center p-4 rounded" style="background: rgba(22, 160, 133, 0.05); border-left: 4px solid var(--accent-color);" data-aos="fade-up">
                    <p class="mb-0 text-muted">
                        <i class="bi bi-shield-check text-success me-2"></i>
                        Vos données sont sécurisées et protégées conformément au RGPD.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}