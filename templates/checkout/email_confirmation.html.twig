<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>Confirmation commande</title></head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:30px 0;">
<tr><td align="center">
<table width="580" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:12px;overflow:hidden;">
    <tr>
        <td style="background:#dc3545;padding:28px 36px;text-align:center;">
            <h1 style="color:#fff;margin:0;font-size:22px;">ECP – Emballé c'est pesé</h1>
            <p style="color:rgba(255,255,255,.85);margin:4px 0 0;font-size:13px;">Confirmation de commande #{{ commande.numCde }}</p>
        </td>
    </tr>
    <tr>
        <td style="padding:28px 36px;">
            <p style="font-size:15px;color:#333;">Merci pour votre commande ! Elle sera expédiée sous 48h.</p>

            <table width="100%" cellpadding="0" cellspacing="0" style="margin:20px 0;border:1px solid #eee;border-radius:8px;overflow:hidden;">
                <tr style="background:#f9f9f9;">
                    <th style="padding:10px 14px;text-align:left;font-size:13px;color:#555;">Produit</th>
                    <th style="padding:10px 14px;text-align:center;font-size:13px;color:#555;">Qté</th>
                    <th style="padding:10px 14px;text-align:right;font-size:13px;color:#555;">Prix</th>
                </tr>
                {% for id, item in panier %}
                <tr>
                    <td style="padding:10px 14px;font-size:14px;border-top:1px solid #eee;">{{ item.produit.libPds }}</td>
                    <td style="padding:10px 14px;text-align:center;font-size:14px;border-top:1px solid #eee;">{{ item.quantite }}</td>
                    <td style="padding:10px 14px;text-align:right;font-size:14px;border-top:1px solid #eee;">{{ (item.produit.prixPds * item.quantite)|number_format(2, ',', ' ') }} €</td>
                </tr>
                {% endfor %}
                <tr style="background:#fff8f8;">
                    <td colspan="2" style="padding:12px 14px;font-weight:700;border-top:2px solid #eee;">Total TTC</td>
                    <td style="padding:12px 14px;text-align:right;font-weight:700;color:#dc3545;border-top:2px solid #eee;">{{ total|number_format(2, ',', ' ') }} €</td>
                </tr>
            </table>

            <p style="font-size:13px;color:#888;">Des questions ? Contactez-nous à <a href="mailto:emballep@gmail.com" style="color:#dc3545;">emballep@gmail.com</a></p>
        </td>
    </tr>
    <tr>
        <td style="background:#f9f9f9;padding:16px 36px;text-align:center;">
            <p style="margin:0;font-size:11px;color:#aaa;">© ECP – Emballé c'est pesé • 75001 Paris</p>
        </td>
    </tr>
</table>
</td></tr>
</table>
</body>
</html>
