                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                <div class="nav-user-panel">
                                    <div class="nav-user-panel-header">
                                        <div class="nav-user-panel-avatar">
                                            {{ (app.user.utilisateur ? app.user.utilisateur.nomUser : app.user.email)|slice(0,1)|upper }}
                                        </div>
                                        <div>
                                            <strong>{% if app.user.utilisateur %}{{ app.user.utilisateur.nomUser }}{% else %}Mon compte{% endif %}</strong>
